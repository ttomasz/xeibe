]

def epsg_version() -> str: ...
def epsg_date() -> str: ...
def projjson(code: int) -> str | None: ...
def alias(name: str) -> int | None: ...
def crs_records() -> list[
    tuple[int, str, str, int, bool, tuple[float, float, float, float] | None]
]: ...
def clear_grids() -> None: ...
def crs_remarks(code: int) -> str | None: ...
def operation_remarks(code: int) -> str | None: ...
def extent(x: Any, y: Any) -> tuple[float, float, float, float] | None: ...
def esri_code(code: int) -> int | None: ...
def wkt_to_projjson(text: str) -> str: ...
def to_wkt(projjson: str, version: str, pretty: bool = False, axes: bool | None = None) -> str: ...
@final
class Crs:
    def __new__(cls, text: str) -> Crs: ...
    def equivalent(self, other: Crs, ignore_axis_order: bool = False) -> bool: ...
    def identify(self) -> list[tuple[int, int]]: ...

@final
class OperationInfo:
    @property
    def name(self) -> str: ...
    @property
    def code(self) -> tuple[int, bool] | None: ...
    @property
    def steps(self) -> list[tuple[int, bool]]: ...
    @property
    def accuracy(self) -> float | None: ...
    @property
    def area(self) -> tuple[float, float, float, float] | None: ...
    @property
    def area_name(self) -> str | None: ...
    @property
    def grids(self) -> list[str]: ...
    @property
    def time_dependent(self) -> bool: ...
    @property
    def scope(self) -> str | None: ...

@final
class Transform:
    def __new__(
        cls,
        source: str,
        target: str,
        always_xy: bool,
        grids: bool,
        local: list[str] | None = None,
    ) -> Transform: ...
    def inverse(self) -> Transform: ...
    def operation_info(self) -> list[OperationInfo]: ...
    def operation_index_for(self, x: float, y: float, z: float | None = None) -> int | None: ...
    def with_operation_index(self, index: int) -> Transform | None: ...
    def operations(self) -> list[str]: ...
    def operation_for(self, x: float, y: float, z: float | None = None) -> str | None: ...
    def grids(self) -> list[str]: ...
    def grid_requests(
        self, bounds: tuple[float, float, float, float] | None = None
    ) -> list[tuple[str, int, int | None]]: ...
    def add_grid_data(self, file: str, offset: int, data: bytes) -> None: ...
    def convert(
        self,
        x: Any,
        y: Any,
        z: Any | None = None,
        radians_in: bool = False,
        radians_out: bool = False,
    ) -> None: ...
    def convert_bounds(
        self, bounds: tuple[float, float, float, float], densify: int
    ) -> tuple[float, float, float, float]: ...

@final
class Geodesic:
    def __new__(cls, a: float, f: float) -> Geodesic: ...
    def fwd(self, lons: Any, lats: Any, azis: Any, dists: Any, radians: bool, back_azimuth: bool) -> None: ...
    def inv(self, lons1: Any, lats1: Any, lons2: Any, lats2: Any, radians: bool, back_azimuth: bool) -> None: ...
    def line(self, lat1: float, lon1: float, azi1: float) -> GeodesicLine: ...
    def inverse_line(self, lat1: float, lon1: float, lat2: float, lon2: float) -> GeodesicLine: ...
    def line_length(self, lons: Any, lats: Any, radians: bool) -> float: ...
    def polygon_area_perimeter(self, lons: Any, lats: Any, radians: bool) -> tuple[float, float]: ...

@final
class GeodesicLine:
    @property
    def distance(self) -> float: ...
    def fill(
        self,
        lons: Any,
        lats: Any,
        azis: Any | None,
        initial_idx: int,
        del_s: float,
        radians: bool,
        back_azimuth: bool,
    ) -> None: ...

def reverse_azimuth(azis: Any, radians: bool) -> None: ...
def ellipsoids() -> list[tuple[str, float, str, float, str]]: ...
def prime_meridians() -> list[tuple[str, str]]: ...
